# Ambiente di sviluppo locale per l'API PigroCRM (packages/core/src/pigrocrm/core/config.py).
# Copia questo file in `.env` (alla radice del repository, dove gira `uv run uvicorn ...` /
# `uv run pytest`) -- `.env` è già in .gitignore, così un segreto locale non finisce mai
# in un commit. `Settings` (pydantic-settings) lo carica da sola dalla working directory,
# nessuna altra configurazione è necessaria.

PIGROCRM_DATABASE_URL=postgresql+psycopg://pigrocrm:pigrocrm@localhost:5432/pigrocrm
# Solo per sviluppo locale: qualunque stringa di almeno 32 caratteri (Settings la
# rifiuta all'avvio se più corta, RFC 7518 §3.2). In produzione dev'essere un segreto
# vero, mai questo valore.
PIGROCRM_JWT_SECRET=cambia-questo-con-un-segreto-vero-di-almeno-32-caratteri

# Perché questa riga esiste ed è `false` SOLO qui:
# Il proxy di Vite (apps/web/vite.config.ts) serve l'API di sviluppo su semplice
# http://localhost, senza TLS. Chrome e Firefox trattano "localhost" come un secure
# context e inviano comunque un cookie `Secure` su HTTP in quel caso -- ma Safari no,
# e non ha in programma di farlo. Con il default di produzione (`cookie_secure=true`,
# vedi il commento su Settings.cookie_secure in packages/core/src/pigrocrm/core/config.py)
# lasciato attivo qui, il login su Safari in sviluppo risponderebbe comunque 200 mentre
# il browser scarta silenziosamente il cookie: ogni richiesta successiva risulterebbe
# "non autenticata", senza un solo errore visibile in nessun log a spiegare perché.
#
# NON impostare questa variabile a `false` in produzione pensando sia una formalità:
# lì l'API sta dietro TLS vero, e `Secure` è l'unica cosa che impedisce a chi intercetta
# una rete non cifrata di rigiocare il cookie catturato.
PIGROCRM_COOKIE_SECURE=false
