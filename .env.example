# Ambiente di sviluppo locale per l'API PigroCRM (packages/core/src/pigrocrm/core/config.py).
# Copia questo file in `.env` (alla radice del repository, dove gira `uv run uvicorn ...` /
# `uv run pytest`) -- `.env` è già in .gitignore, così un segreto locale non finisce mai
# in un commit. `Settings` (pydantic-settings) lo carica da sola dalla working directory,
# nessuna altra configurazione è necessaria.

PIGROCRM_DATABASE_URL=postgresql+psycopg://pigrocrm:pigrocrm@localhost:5432/pigrocrm
# Solo per sviluppo locale: qualunque stringa di almeno 32 caratteri (Settings la
# rifiuta all'avvio se più corta, RFC 7518 §3.2). In produzione dev'essere un segreto
# vero, mai questo valore.
PIGROCRM_JWT_SECRET=cambia-questo-con-un-segreto-vero-di-almeno-32-caratteri

# Sei mesi, scorrevoli: `/api/auth/refresh` consuma il vecchio jti e ne emette uno
# nuovo la cui scadenza si misura da adesso, quindi chi usa il CRM non rivede mai il
# login e chi lo lascia stare per sei mesi lo rivede (slice 9 §5.6). L'access token
# resta a quindici minuti: è la finestra di revoca, non la durata della sessione.
PIGROCRM_REFRESH_TOKEN_DAYS=180

# Perché questa riga esiste ed è `false` SOLO qui:
# Il proxy di Vite (apps/web/vite.config.ts) serve l'API di sviluppo su semplice
# http://localhost, senza TLS. Chrome e Firefox trattano "localhost" come un secure
# context e inviano comunque un cookie `Secure` su HTTP in quel caso -- ma Safari no,
# e non ha in programma di farlo. Con il default di produzione (`cookie_secure=true`,
# vedi il commento su Settings.cookie_secure in packages/core/src/pigrocrm/core/config.py)
# lasciato attivo qui, il login su Safari in sviluppo risponderebbe comunque 200 mentre
# il browser scarta silenziosamente il cookie: ogni richiesta successiva risulterebbe
# "non autenticata", senza un solo errore visibile in nessun log a spiegare perché.
#
# NON impostare questa variabile a `false` in produzione pensando sia una formalità:
# lì l'API sta dietro TLS vero, e `Secure` è l'unica cosa che impedisce a chi intercetta
# una rete non cifrata di rigiocare il cookie catturato.
PIGROCRM_COOKIE_SECURE=false

# --- Gmail (slice 5). Lascia PIGROCRM_GOOGLE_CLIENT_ID vuota per girare senza Gmail:
# non è una funzione rotta, è una funzione assente. L'interfaccia nasconde la sezione,
# gli endpoint rispondono Conflict e gli strumenti MCP non vengono nemmeno registrati.
# È quello che permette a chi si auto-ospita proprio per non avere Google di non averlo.
# Vanno impostate tutte e quattro o nessuna: un client id senza chiave di cifratura
# collegherebbe un account per poi non riuscire a salvarne il refresh token.
PIGROCRM_GOOGLE_CLIENT_ID=
PIGROCRM_GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
# 32 byte esatti: cifra `google_accounts.refresh_token_ciphertext` a riposo (AES-256-GCM).
# Vive fuori dal database di proposito -- un dump, un backup o un pg_dump allegato a una
# segnalazione di bug sono superfici di esposizione diverse dal sistema in esecuzione, e
# questa credenziale apre un account di *terze parti*, non solo questa applicazione.
PIGROCRM_GOOGLE_TOKEN_KEY=
# L'origine pubblica. Google confronta {PIGROCRM_PUBLIC_URL}/api/gmail/oauth/callback
# con il redirect URI autorizzato carattere per carattere.
PIGROCRM_PUBLIC_URL=
# `true` finché il client OAuth non è verificato (stato Testing): in quel caso il refresh
# token di un account consumer scade 7 giorni dopo il consenso, e l'interfaccia avvisa
# 48 ore prima. Google non espone un'API per saperlo, quindi lo dichiara chi installa.
PIGROCRM_GOOGLE_APP_UNVERIFIED=false

# --- Superficie MCP -------------------------------------------------------------
# Se un token personale (PAT) possa eseguire anche le sedici operazioni elencate in
# `packages/core/src/pigrocrm/core/actor.py::AGENT_FORBIDDEN_ACTIONS` — emettere e
# annullare fatture, il profilo fiscale, le tariffe, le categorie di costo, le chiusure
# di periodo, il ponte ore→fattura e la stima annuale.
#
# `false` è il default, ed è il default che nessuno deve conoscere per essere al sicuro.
# Quelle operazioni non sono solo privilegiate: sono **irreversibili in un modo in cui il
# resto del prodotto non lo è**. Emettere consuma un numero di un registro fiscale senza
# buchi, che non si restituisce; una mail inviata è nella casella di qualcun altro.
# L'esito peggiore non è «l'agente ha sbagliato», è «l'agente ha sbagliato e non si può
# annullare».
#
# Metterla a `true` è una decisione su *questa* installazione, ed è legittima: il prodotto
# è single-tenant e auto-ospitato, e chi lo usa può ragionevolmente volere che il proprio
# agente faccia tutto ciò che fa lui. Il valore è letto una volta sola, in
# `PatService.resolve`, e impresso sulla credenziale — quindi vale identico su MCP e su
# REST, che è ciò che impedisce ai due adattatori di dire cose diverse sullo stesso token.
#
# Non sostituisce il ruolo: il token di un utente `readonly` resta in sola lettura.
PIGROCRM_MCP_FULL_ACCESS=false

# ---------------------------------------------------------------------------
# Da qui in giù: solo per `docker compose up` (docker-compose.yml), non per lo
# sviluppo locale sopra. `docker compose` carica automaticamente questo stesso
# file -- una volta copiato in `.env` alla radice del repository, dove vive anche
# docker-compose.yml -- per sostituire i `${...}` nel compose file stesso. Non lo
# inietta però nei container: ogni servizio riceve solo le variabili che il suo
# blocco `environment:` nomina esplicitamente. È per questo che le due sezioni di
# questo stesso file possono coesistere senza scontrarsi:
#
# - PIGROCRM_DATABASE_URL sopra punta a un Postgres locale su localhost:5432, per
#   chi lancia `uv run uvicorn`/`uv run pytest` direttamente sull'host. Il
#   container `api` del compose stack ignora del tutto questo valore: costruisce
#   la propria URL da POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB qui sotto,
#   puntata all'host di rete interno `db`, non a `localhost`.
# - PIGROCRM_JWT_SECRET sopra è la stessa variabile che il container `api` riceve:
#   un solo segreto, per entrambi i flussi. Se lo generi con `openssl rand -hex 32`
#   per lo sviluppo locale, genera un segreto **diverso** (e mai commesso) prima
#   di usare questo file per un deploy vero.
# - PIGROCRM_COOKIE_SECURE sopra resta `false` per lo sviluppo locale, ma
#   docker-compose.yml non la passa al container `api` -- di proposito, con il
#   motivo scritto per esteso lì. `docker compose up` riceve quindi sempre il
#   default sicuro di Settings (`cookie_secure=True`), qualunque cosa dica questo
#   file. Perché quel default funzioni davvero (perché il browser tenga il cookie
#   invece di scartarlo) il server reale deve terminare TLS per davvero --
#   deploy/setup-server.sh configura nginx sull'host, ma il certificato
#   (`certbot --nginx -d "$PIGROCRM_DOMAIN"`) resta un passo manuale, una tantum.

# Credenziali del Postgres gestito da compose (servizio `db`, volume
# `pigrocrm-db`): non quello che potresti avere in ascolto su localhost:5432 per
# lo sviluppo diretto sopra. Necessaria: senza una password compose si rifiuta di
# partire (`${POSTGRES_PASSWORD:?serve una password}` in docker-compose.yml).
POSTGRES_USER=pigrocrm
POSTGRES_PASSWORD=
POSTGRES_DB=pigrocrm
