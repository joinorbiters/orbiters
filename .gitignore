*.tsbuildinfo
# Playwright's run state and its per-failure artefact directories. It rewrites
# `test-results/.last-run.json` on every run and drops a `test-results/<test>/`
# with an `error-context.md` for every failure, so without this line a finished
# e2e run leaves a modified tracked file and untracked directories that are
# nobody's work, and `git add -A` ships a test run's timestamp to the trunk.
test-results/

# Env
.env
.env.local

# Storage locale dei documenti (LocalFileStorage)
var/
# Postgres data when PIGROCRM_DATA_DIR is left at its default
data/

# Playwright MCP snapshots and console logs written while I look at pages
.playwright-mcp/
# Screenshots I take while reviewing pages
*.png
!**/public/*.png
