FROM python:3.13-slim-bookworm

# Pinned to the exact versions `pigrocrm.core.render` was built and verified against
# (real compiles, real PDFs read back with `pdftotext` -- see
# packages/core/tests/test_render_pdf.py and test_template_escaping.py): Pandoc
# 3.8.2.1 and Typst 0.14.2, not the older pair `the reference copy/Dockerfile` used
# (Pandoc 3.1.12.2 / Typst 0.11.0). Typst's own diagnostic format
# (`render/diagnostics.py`'s `_LOCATION_RE`) and the auto-typography workaround
# (`render/pdf.py`'s `_defeat_typst_autotypography`) were both confirmed against
# 0.14.2 specifically, not assumed stable across major Typst releases. Typst embeds
# Libertinus Serif, so no separate font package is needed here.
ARG TYPST_VERSION=0.14.2
ARG PANDOC_VERSION=3.8.2.1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq5 ca-certificates curl xz-utils \
    && curl -fL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
       | tar -xz -C /tmp \
    && mv /tmp/pandoc-${PANDOC_VERSION}/bin/pandoc /usr/local/bin/pandoc \
    && chmod +x /usr/local/bin/pandoc \
    && curl -fL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
       | tar -xJ -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && chmod +x /usr/local/bin/typst \
    && apt-get purge -y curl xz-utils && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/pandoc-${PANDOC_VERSION} /tmp/typst-x86_64-unknown-linux-musl

COPY --from=ghcr.io/astral-sh/uv:0.9.24 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/
COPY apps/api/pyproject.toml apps/api/
COPY apps/mcp/pyproject.toml apps/mcp/
RUN uv sync --frozen --no-dev --no-install-project

COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/mcp ./apps/mcp
RUN uv sync --frozen --no-dev

EXPOSE 8000
# Migrations run at start-up: one instance, so there is no concurrent-migration risk.
#
# `--no-sync` on both calls is load-bearing, not decoration: without it, `uv run`
# re-evaluates the environment against pyproject.toml's *default* group selection --
# which includes the `dev` group (mypy, ruff, pytest, ...) since nothing here opts
# out of it the way the two build-time `uv sync --frozen --no-dev` calls above do --
# and finds the image's venv (built with --no-dev) "out of date", so it syncs dev
# dependencies in over the network on every single container start. Confirmed live:
# the very first `docker compose up` of this image, before this flag was added,
# printed "Downloading mypy (13.5MiB)" / "Downloading ruff (10.4MiB)" to its own
# startup log. That is dev tooling landing inside a running "production" container
# after all, just one step later than a `docker build` layer -- and on a host with
# no route to PyPI, or one where it is slow, this is the difference between the
# container starting and not. `--no-sync` makes uv trust the image's own venv
# exactly as built and skip that check entirely.
CMD ["sh", "-c", "cd packages/core && uv run --no-sync alembic upgrade head && cd /app && uv run --no-sync uvicorn pigrocrm_api.main:app --host 0.0.0.0 --port 8000"]
