# The Orbiters hub (projects/hub). Copy to `.env` beside docker-compose.yml on the server;
# `.env` is gitignored. Local development reads the same prefix from the repository root.

# Local development: the hub's own Postgres, never PigroCRM's.
ORBITERS_DATABASE_URL=postgresql+psycopg://orbiters:orbiters@localhost:55435/orbiters

# --- ChatGPT Ads: the signup conversion ---------------------------------------------
# The pixel id is public (it sits in the website's markup); the key is a secret with
# write access to the conversion source and belongs in this file on the server only.
# Leave both empty and no server event is sent. Check the key without inventing a
# conversion:  docker compose -p orbiters exec api uv run --no-sync orbiters conversions-check
ORBITERS_OPENAI_PIXEL_ID=
ORBITERS_OPENAI_CONVERSIONS_API_KEY=
ORBITERS_SIGNUP_URL=https://joinorbiters.com/
ORBITERS_OPENAI_CONVERSIONS_SEND_HASHED_EMAIL=false

# --- docker compose only -------------------------------------------------------------
POSTGRES_USER=orbiters
POSTGRES_PASSWORD=
POSTGRES_DB=orbiters
# Postgres data on the host, outside Docker and outside the repository.
ORBITERS_DATA_DIR=/srv/orbiters-data/postgres
ORBITERS_DB_PORT=127.0.0.1:55435
ORBITERS_API_PORT=127.0.0.1:8084
