FROM node:22-bookworm-slim AS build

# Kept in step with `packageManager` in the repository root's package.json. Two places
# name the version because corepack cannot read the field before the file it is in has
# been copied, and installing with a different major than the one that wrote
# pnpm-lock.yaml is how a lockfile silently stops being frozen.
RUN corepack enable && corepack prepare pnpm@11.6.0 --activate
WORKDIR /app

# The build context is the repository root, not this directory (see the `context:`
# key in docker-compose.yml): the pnpm workspace root -- package.json,
# pnpm-workspace.yaml and the one pnpm-lock.yaml shared by every Node project in the
# monorepo -- lives two levels above this app.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY projects/pigrocrm/apps/web/package.json projects/pigrocrm/apps/web/
# The website is its own project (`projects/website`) and its own package. It is built
# into this image, and the two `COPY --from=build` lines below serve it at the document
# root, only because the two share an origin today: one TLS certificate, one nginx, one
# deploy, and an "Accedi" link that needs no cross-origin thought. That is a serving
# arrangement, not a source dependency, and it is transitional: the community site is
# not the CRM's, and giving it its own image and its own vhost moves two live domains,
# which is a change to make deliberately rather than as a side effect of a refactor.
# ORB-12 carries it.
COPY projects/website/package.json projects/website/
COPY shared/brand/package.json shared/brand/
RUN pnpm install --frozen-lockfile --filter web... --filter website...

COPY shared/brand ./shared/brand
COPY projects/website ./projects/website
COPY projects/pigrocrm/apps/web ./projects/pigrocrm/apps/web
RUN pnpm --filter web build && pnpm --filter website build

FROM nginx:1.27-alpine
# The website at the document root, the SPA one directory down. Two builds, one
# origin: one TLS certificate, one nginx, one deploy, and an "Accedi" link that
# needs no cross-origin thought.
COPY --from=build /app/projects/website/dist /usr/share/nginx/html
COPY --from=build /app/projects/pigrocrm/apps/web/dist /usr/share/nginx/html/app
COPY projects/pigrocrm/deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
