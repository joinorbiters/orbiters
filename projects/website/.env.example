# The website's environment. One variable, because the site has no state: no
# database, no secrets, nothing to rotate.
#
# Compose reads this file from the directory of the compose file by default; the
# deploy passes `--env-file` pointing at the environment root's own copy, so preview
# and production keep separate values on the same host.

# Host port the container publishes on, always on the loopback: nginx on the host is
# what faces the internet. Production 8082, preview 8083 on this server.
WEBSITE_WEB_PORT=127.0.0.1:8082
